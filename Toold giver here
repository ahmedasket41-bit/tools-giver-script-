local function flash(btn, color)
    if not btn or not btn.Parent then return end
    btn.BackgroundColor3 = color
    task.delay(0.45, function()
        if btn and btn.Parent then
            TweenService:Create(btn, TweenInfo.new(0.3), { BackgroundColor3 = ITEM }):Play()
        end
    end)
end

local fpp = fireproximityprompt
local fcd = fireclickdetector

local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)
local GuiService = game:GetService("GuiService")

local function ownsTool(tool)
    return tool.Parent == lp.Backpack or tool.Parent == lp.Character
end

-- how many tools with this name we hold (some games delete the world copy and hand us a clone)
local function countNamed(name)
    local n = 0
    for _, holder in ipairs({ lp:FindFirstChildOfClass("Backpack"), lp.Character }) do
        if holder then
            for _, c in ipairs(holder:GetChildren()) do
                if c:IsA("Tool") and c.Name == name then
                    n = n + 1
                end
            end
        end
    end
    return n
end

----------------------------------------------------------------
-- World pickups: ProximityPrompt / ClickDetector
----------------------------------------------------------------
local function isInteractable(o)
    return o:IsA("ProximityPrompt") or o:IsA("ClickDetector")
end

local function inPlayerCharacter(inst)
    local m = inst:FindFirstAncestorOfClass("Model")
    return m ~= nil and Players:GetPlayerFromCharacter(m) ~= nil
end

local function findInteractables(tool, handle)
    local list, seen = {}, {}
    local function add(o)
        if not seen[o] then
            seen[o] = true
            list[#list + 1] = o
        end
    end

    for _, d in ipairs(tool:GetDescendants()) do
        if isInteractable(d) then add(d) end
    end

    local p = tool.Parent
    if p and (p:IsA("Model") or p:IsA("BasePart")) and not inPlayerCharacter(tool) then
        for _, d in ipairs(p:GetChildren()) do
            if isInteractable(d) then
                add(d)
            elseif d:IsA("Attachment") then
                for _, a in ipairs(d:GetChildren()) do
                    if isInteractable(a) then add(a) end
                end
            end
        end
    end

    local ok, parts = pcall(function()
        return Workspace:GetPartBoundsInRadius(handle.Position, 8)
    end)
    if ok and parts then
        local near = {}
        for _, part in ipairs(parts) do
            if not inPlayerCharacter(part) then
                local dist = (part.Position - handle.Position).Magnitude
                for _, d in ipairs(part:GetChildren()) do
                    if isInteractable(d) then
                        near[#near + 1] = { d, dist }
                    elseif d:IsA("Attachment") then
                        for _, a in ipairs(d:GetChildren()) do
                            if isInteractable(a) then near[#near + 1] = { a, dist } end
                        end
                    end
                end
            end
        end
        table.sort(near, function(a, b) return a[2] < b[2] end)
        for i = 1, math.min(#near, 4) do
            add(near[i][1])
        end
    end

    return list
end

local function trigger(list, changed, useHold)
    for _, o in ipairs(list) do
        if o.Parent then
            if o:IsA("ProximityPrompt") then
                if changed[o] == nil then
                    changed[o] = o.HoldDuration
                    pcall(function() o.HoldDuration = 0 end) -- long press becomes instant
                end
                if fpp and not useHold then
                    pcall(fpp, o)
                else
                    pcall(function()
                        o:InputHoldBegin()
                        task.wait(0.05)
                        o:InputHoldEnd()
                    end)
                end
            elseif fcd then
                pcall(fcd, o)
            end
        end
    end
end

----------------------------------------------------------------
-- Game GUI pickup button (the "Take" button on the screen)
----------------------------------------------------------------
local TAKE_WORDS = { "take", "pick", "grab", "collect", "claim", "equip", "loot", "steal",
    "اخذ", "أخذ", "خذ", "التقاط", "جمع" }
local BLOCK_WORDS = { "close", "exit", "sell", "buy", "purchase", "shop", "store", "delete",
    "reset", "robux", "gift", "trade", "report", "quit", "leave", "rebirth", "setting" }

local function hasAny(s, words)
    for _, w in ipairs(words) do
        if s:find(w, 1, true) then return true end
    end
    return false
end

local function isShown(d)
    local cur = d
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return d.AbsoluteSize.X > 0 and d.AbsoluteSize.Y > 0
end

local function snapshotButtons()
    local set = {}
    local pg = lp:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and not d:IsDescendantOf(gui) and isShown(d) then
                set[d] = true
            end
        end
    end
    return set
end

local function labelOf(b)
    local t = b.Name .. " " .. (b.Parent and b.Parent.Name or "")
    if b:IsA("TextButton") then t = t .. " " .. b.Text end
    for _, c in ipairs(b:GetDescendants()) do
        if c:IsA("TextLabel") or c:IsA("TextButton") then
            t = t .. " " .. c.Text
        end
    end
    return t:lower()
end

local function describe(b)
    return b.Name .. (b:IsA("TextButton") and ("[" .. b.Text .. "]") or "")
end

-- buttons that look like "take" + buttons that just appeared because we got near the item
local function pickupButtons(before)
    local now = snapshotButtons()
    local keyword, fresh = {}, {}
    for b in pairs(now) do
        local lab = labelOf(b)
        if not hasAny(lab, BLOCK_WORDS) then
            if hasAny(lab, TAKE_WORDS) then
                keyword[#keyword + 1] = b
            elseif not before[b] then
                fresh[#fresh + 1] = b
            end
        end
    end
    local out = {}
    for i = 1, math.min(#keyword, 4) do out[#out + 1] = keyword[i] end
    for i = 1, math.min(#fresh, 3) do out[#out + 1] = fresh[i] end
    return out
end

local function guiCenter(b)
    local pos = b.AbsolutePosition + b.AbsoluteSize / 2
    local sg = b:FindFirstAncestorOfClass("ScreenGui")
    if not (sg and sg.IgnoreGuiInset) then
        pos = pos + (GuiService:GetGuiInset())
    end
    return pos
end

local function connPress(b, hold)
    local function fire(ev)
        local fired = false
        if getconnections then
            local okc, cons = pcall(getconnections, ev)
            if okc and cons then
                for _, c in ipairs(cons) do
                    if pcall(function() c:Fire() end) then fired = true end
                end
            end
        end
        if not fired and firesignal then
            fired = pcall(firesignal, ev)
        end
        return fired
    end
    fire(b.MouseButton1Down)
    if hold then task.wait(hold) end
    fire(b.MouseButton1Up)
    fire(b.MouseButton1Click)
    fire(b.Activated)
end

local pressing = {}

-- tap (hold = nil) or long press (hold = seconds): fires the button's own handlers AND a real screen click
local function pressButton(b, hold)
    if pressing[b] then return end
    pressing[b] = true
    task.delay((hold or 0.05) + 0.3, function() pressing[b] = nil end)

    task.spawn(function()
        pcall(connPress, b, hold)
    end)
    task.spawn(function()
        pcall(function()
            if VIM and b.Parent and isShown(b) then
                local c = guiCenter(b)
                VIM:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
                task.wait(hold or 0.05)
                VIM:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
            end
        end)
    end)
end

----------------------------------------------------------------
-- Grab
----------------------------------------------------------------
local function grab(tool, btn)
    if busy or dead then return end

    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return end

    if not (tool and tool.Parent) then
        flash(btn, RED)
        return
    end

    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
    if not handle then
        flash(btn, RED)
        return
    end

    busy = true
    local backCF = hrp.CFrame -- the spot to return to
    local name = tool.Name
    local before = countNamed(name)
    local guiBefore = snapshotButtons() -- buttons visible BEFORE we get near the item
    local changed = {}
    local seenCount = 0
    local triedButtons = {}
    local ok = false

    local function got()
        return ownsTool(tool) or countNamed(name) > before
    end

    pcall(function()
        local offsets = {
            CFrame.new(),
            CFrame.new(0, 2, 0),
            CFrame.new(0, -1.5, 0),
            CFrame.new(1.5, 0, 0),
        }
        local limbNames = { "RightHand", "Right Arm", "LeftHand", "Left Arm", "Head" }

        for attempt = 1, #offsets do
            local t1 = os.clock()
            local lastTrigger = 0
            -- odd attempts = quick tap, even attempts = long press
            local useHold = (attempt % 2 == 0)

            while os.clock() - t1 < 1.7 do
                if got() then break end
                if not (hrp.Parent and tool.Parent and handle.Parent) then break end

                -- someone else grabbed it first
                local p = tool.Parent
                if p ~= lp.Character and p:IsA("Model") and Players:GetPlayerFromCharacter(p) then break end

                hrp.CFrame = handle.CFrame * offsets[attempt]
                hrp.AssemblyLinearVelocity = Vector3.zero

                -- touch pickup
                if fti then
                    pcall(function()
                        fti(hrp, handle, 0)
                        fti(hrp, handle, 1)
                        for _, n in ipairs(limbNames) do
                            local part = char:FindFirstChild(n)
                            if part and part:IsA("BasePart") then
                                fti(part, handle, 0)
                                fti(part, handle, 1)
                            end
                        end
                    end)
                end

                -- press pickup: wait a moment so the server knows where we are, then press every 0.4s
                local now = os.clock()
                if now - t1 > 0.15 and now - lastTrigger > 0.4 then
                    lastTrigger = now

                    -- 1) prompt / click detector in the world
                    local list = findInteractables(tool, handle)
                    if #list > seenCount then seenCount = #list end
                    trigger(list, changed, useHold)

                    -- 2) the game's own "take" button on the screen
                    for _, b in ipairs(pickupButtons(guiBefore)) do
                        triedButtons[describe(b)] = true
                        pressButton(b, useHold and 1.4 or nil)
                    end
                end

                task.wait(0.05)
            end

            if got() or not (hrp.Parent and tool.Parent and handle.Parent) then break end
        end

        -- the game may delete the world copy and give a clone: wait a moment for it
        if not got() and not tool.Parent then
            local t2 = os.clock()
            while os.clock() - t2 < 1 and not got() do
                task.wait(0.05)
            end
        end

        ok = got()
    end)

    -- put hold times back the way the game had them
    for o, old in pairs(changed) do
        pcall(function() o.HoldDuration = old end)
    end

    -- let the server settle, then go back and stay there
    if hrp.Parent then
        task.wait(0.1)
        for _ = 1, 3 do
            if not hrp.Parent then break end
            hrp.CFrame = backCF
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.1)
        end
    end

    local names = {}
    for k in pairs(triedButtons) do names[#names + 1] = k end
    print(string.format("[ToolGrabber] %s -> %s | prompts/clicks: %d | screen buttons pressed: %s",
        name, ok and "TAKEN" or "FAILED", seenCount, #names > 0 and table.concat(names, ", ") or "none"))

    busy = false
    flash(btn, ok and GREEN or RED)
end

----------------------------------------------------------------
-- Tool list
----------------------------------------------------------------
local function valid(tool)
    if not tool:IsDescendantOf(Workspace) then return false end
    local p = tool.Parent
    if p and p:IsA("Model") and Players:GetPlayerFromCharacter(p) then
        return false -- held by a player
    end
    return true
end

local function collect()
    local list = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("Tool") and valid(d) then
            list[#list + 1] = d
        end
    end
    table.sort(list, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)
    return list
end

local pending = false
local rebuild

local function schedule()
    if pending or dead then return
pending = true
    task.delay(0.25, function()
        pending = false
        if not dead then
            rebuild()
        end
    end)
end

rebuild = function()
    for _, c in ipairs(itemConns) do
        pcall(function() c:Disconnect() end)
    end
    itemConns = {}

    for _, ch in ipairs(scroll:GetChildren()) do
        if ch.Name == "Item" then
            ch:Destroy()
        end
    end

    local tools = collect()
    title.Text = "TOOL GRABBER  [" .. #tools .. "]"
    emptyLabel.Visible = #tools == 0

    for i, tool in ipairs(tools) do
        local btn = new("TextButton", {
            Name = "Item",
            Size = UDim2.new(1, 0, 0, 48),
            BackgroundColor3 = ITEM,
            AutoButtonColor = false,
            Text = "",
            LayoutOrder = i,
        }, scroll)
        new("UICorner", { CornerRadius = UDim.new(0, 10) }, btn)

        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 6),
            Size = UDim2.new(1, -24, 0, 22),
            Font = Enum.Font.GothamBold,
            TextSize = 15,
            TextColor3 = WHITE,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = tool.Name,
        }, btn)

        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 27),
            Size = UDim2.new(1, -24, 0, 16),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(150, 150, 180),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = "in: " .. (tool.Parent and tool.Parent.Name or "?"),
        }, btn)

        btn.Activated:Connect(function()
            task.spawn(grab, tool, btn)
        end)

        table.insert(itemConns, tool.AncestryChanged:Connect(schedule))
    end
end

table.insert(conns, Workspace.DescendantAdded:Connect(function(d)
    if d:IsA("Tool") then schedule() end
end))
table.insert(conns, Workspace.DescendantRemoving:Connect(function(d)
    if d:IsA("Tool") then schedule() end
end))

rebuild()
